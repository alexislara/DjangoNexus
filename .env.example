# ==========================================================
# Plantilla de variables de entorno — django-base
# ==========================================================
# Uso:
#     cp .env.example .env
#     # editá .env y completá los valores marcados como "cambiar"
#
# `.env` está en `.gitignore` y nunca se versiona: este archivo sí.
# Los valores de abajo son placeholders, NO son credenciales reales.
# ==========================================================

# ---- Django ----
# Clave secreta. Generá una con:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY="cambiar-por-una-clave-aleatoria-de-50-caracteres"

# Módulo de settings a usar.
#   config.settings       → SQLite, sin dependencias externas (quickstart).
#   config.settings.local → Postgres, lee POSTGRES_* (requiere base de datos).
DJANGO_SETTINGS_MODULE=config.settings.local

# Entorno de ejecución: development | staging | production
DJANGO_ENV=development

# Modo debug. En desarrollo conviene True; nunca True en producción.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma. En local se puede dejar en "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Interruptor de permisos (lo espera el stack de OAuth2).
DJANGO_PERMISSION_ENABLED=True

# ---- Postgres ----
# Con Docker Compose el host es el nombre del servicio ("db-base").
# Con Postgres instalado en la máquina local: "localhost".
POSTGRES_HOST=db-base
POSTGRES_PORT=5432
POSTGRES_DB=db-base
POSTGRES_USER=postgres
POSTGRES_PASSWORD="cambiar-esta-password"

# ---- MinIO (almacenamiento de archivos y estáticos) ----
# Endpoint host:port del servicio MinIO.
MINIO_STORAGE_ENDPOINT="minio-storage:9000"
MINIO_STORAGE_ACCESS_KEY="cambiar-access-key"
MINIO_STORAGE_SECRET_KEY="cambiar-secret-key"
MINIO_STORAGE_BUCKET_NAME=bucket-staging
# URL pública con la que se sirve el bucket (proxy).
MINIO_STORAGE_PROXY_URL="http://localhost:9000"
STATICFILES_STORAGE="minio_storage.storage.MinioStaticStorage"
DEFAULT_FILE_STORAGE="minio_storage.storage.MinioMediaStorage"

# ---- Email (Mailhog en desarrollo) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_FROM=noreply@example.com
EMAIL_USE_TLS=False

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_VHOST=rabbitmq
RABBITMQ_DEFAULT_PORT=5672
RABBITMQ_DEFAULT_USER="user"
RABBITMQ_DEFAULT_PASS="password"

# ---- Frontend ----
FRONTEND_URL="http://localhost:3000"

# ---- OAuth2 / OIDC ----
DJANGO_OAUTH2_CLIENT_ID="cambiar-oauth2-client-id"
DJANGO_OAUTH2_CLIENT_SECRET="cambiar-oauth2-client-secret"
DJANGO_OAUTH2_URL="https://your-oauth2-provider.com"
# Issuer OIDC: debe ser EXACTAMENTE el mismo valor en el discovery, en el `iss`
# de la respuesta de autorización y en el id_token.
OIDC_ISS_ENDPOINT="http://localhost:8000/o/"

# ---- Worker / MQ ----
WORKER_MQ_URL="amqp://user:password@rabbitmq:5672/rabbitmq"

# ---- Superusuario de bootstrap ----
# Los usa entrypoint.sh cuando RUN_SUPERUSER=true.
DJANGO_ADMIN_EMAIL="admin@example.com"
DJANGO_ADMIN_PASSWORD="cambiar-esta-password"

# ==========================================================
# Flags de bootstrap (entrypoint.sh)
# ==========================================================
# Cada paso se ejecuta solo si su flag está en "true".
# En Cloud Run: activá los que necesites en el arranque y volvé a apagarlos
# después del bootstrap de una sola vez.
RUN_MIGRATIONS=false
RUN_COLLECTSTATIC=false
RUN_OIDC_KEYGEN=false
RUN_FIXTURES=false
RUN_SUPERUSER=false
RUN_LTH_USERS=false
